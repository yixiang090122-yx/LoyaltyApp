@{
    ViewData["Title"] = "Submit Feedback";
    var outlets = ViewBag.Outlets as List<LoyaltyApp.DTOs.OutletDTO> ?? new List<LoyaltyApp.DTOs.OutletDTO>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold mb-2 align-self-start">Customer Voice</span>
                <h1 class="h3 fw-bold text-dark mb-1">Share Your Experience 💬</h1>
                <p class="text-muted small mb-0">Help us improve our service! Your feedback is directly reviewed by store managers and head-office administrators.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <form id="feedbackForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Store Location / Outlet</label>
                        <select name="Location" class="form-select rounded-pill px-3" required>
                            <option value="">-- Choose Branch Location --</option>
                            @foreach (var o in outlets)
                            {
                                <option value="@o.OutletName">@o.OutletName</option>
                            }
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Feedback Category</label>
                            <select name="Category" class="form-select rounded-pill px-3">
                                <option value="Service">Customer Service</option>
                                <option value="Food & Drinks">Food & Beverages</option>
                                <option value="Cleanliness">Store Cleanliness</option>
                                <option value="App & Rewards">App / Rewards Issue</option>
                                <option value="Other">General Feedback</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Rating (1 to 5 Stars)</label>
                            <select name="Rating" class="form-select rounded-pill px-3">
                                <option value="5">⭐⭐⭐⭐⭐ Excellent (5/5)</option>
                                <option value="4">⭐⭐⭐⭐ Good (4/5)</option>
                                <option value="3">⭐⭐⭐ Average (3/5)</option>
                                <option value="2">⭐⭐ Poor (2/5)</option>
                                <option value="1">⭐ Terrible (1/5)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Subject / Title</label>
                        <input type="text" name="Title" class="form-control rounded-pill px-3" placeholder="Brief summary of your feedback" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Detailed Comments</label>
                        <textarea name="Description" class="form-control rounded-4 p-3" rows="4" placeholder="Tell us what you loved or how we can do better..." required></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Member/Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                        <button type="submit" id="submitFeedbackBtn" class="btn btn-primary rounded-pill px-4 fw-semibold">
                            Submit Feedback
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $('#feedbackForm').submit(function (e) {
        e.preventDefault();
        const $btn = $('#submitFeedbackBtn');
        $btn.prop('disabled', true).text('Submitting...');

        $.post('/Member/SubmitFeedback', $(this).serialize(), function (res) {
            $btn.prop('disabled', false).text('Submit Feedback');
            if (res.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Thank You!',
                    text: res.msg,
                    confirmButtonColor: '#0d6efd'
                }).then(() => {
                    window.location.href = '/Member/Index';
                });
            } else {
                Swal.fire('Submission Failed', res.msg, 'error');
            }
        }).fail(function () {
            $btn.prop('disabled', false).text('Submit Feedback');
            Swal.fire('Error', 'Unable to submit feedback at this moment.', 'error');
        });
    });
</script>
}

