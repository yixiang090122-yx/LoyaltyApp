@model List<LoyaltyApp.DTOs.RewardDTO>
@{
    ViewData["Title"] = "Manage Rewards Catalog";
}

<div class="container-fluid py-4 px-4 bg-light min-vh-100">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a href="/Admin/Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">← Dashboard</a>
                <h1 class="h3 fw-bold text-dark mb-0">Rewards Catalog 🎁</h1>
            </div>
            <p class="text-muted small mt-1 mb-0">Configure gifts, drinks, and merchandise that members can redeem using their points.</p>
        </div>

        <button class="btn btn-primary shadow-sm rounded-pill px-4 fw-semibold" data-bs-toggle="modal" data-bs-target="#createRewardModal">
            + Add New Reward
        </button>
    </div>

    <!-- Rewards Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">#ID</th>
                        <th>Reward Title / Name</th>
                        <th>Points Required</th>
                        <th>Validity Period</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-muted">#@r.RewardsID</td>
                                <td>
                                    <div class="fw-bold text-dark">@r.Title</div>
                                    <span class="text-muted small">@r.Name | @r.Description</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-bold">
                                        ⭐ @r.Point Pts
                                    </span>
                                </td>
                                <td class="small text-muted">
                                    @(r.CreateDate?.ToString("yyyy-MM-dd") ?? "-") to @(r.ExpireDate?.ToString("yyyy-MM-dd") ?? "Ongoing")
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">
                                        @(r.Status ?? "Active")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3 delete-reward-btn"
                                            data-id="@r.RewardsID"
                                            data-title="@r.Title">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <div class="fs-1 mb-2">🎁</div>
                                <div>No rewards found in catalog. Click <strong>+ Add New Reward</strong> to create one.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Add Reward -->
<div class="modal fade" id="createRewardModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold">Add Reward Product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="createRewardForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reward Display Title</label>
                        <input type="text" name="Title" class="form-control rounded-pill px-3" placeholder="e.g. Free Signature Coffee" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Internal Name</label>
                        <input type="text" name="FullName" class="form-control rounded-pill px-3" placeholder="e.g. Signature Coffee" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Points Required ⭐</label>
                            <input type="number" name="Point" class="form-control rounded-pill px-3" placeholder="100" min="1" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Short Title / Badge</label>
                            <input type="text" name="ShortTitle" class="form-control rounded-pill px-3" placeholder="Free Drink" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" class="form-control rounded-4 p-3" rows="2" placeholder="Redeem a hot signature coffee with your points."></textarea>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Terms & Conditions</label>
                        <input type="text" name="TnC" class="form-control rounded-pill px-3" placeholder="Redeemable at all outlets. One per transaction." />
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="saveRewardBtn" class="btn btn-primary rounded-pill px-4 fw-semibold">Save Reward</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $('#createRewardForm').submit(function (e) {
        e.preventDefault();
        $('#saveRewardBtn').prop('disabled', true).text('Saving...');
        $.post('/Admin/CreateReward', $(this).serialize(), function (res) {
            $('#saveRewardBtn').prop('disabled', false).text('Save Reward');
            if (res.success) {
                Swal.fire('Saved', res.msg, 'success').then(() => location.reload());
            } else {
                Swal.fire('Error', res.msg, 'error');
            }
        });
    });

    $('.delete-reward-btn').click(function () {
        const id = $(this).data('id');
        const title = $(this).data('title');

        Swal.fire({
            title: 'Delete ' + title + '?',
            text: 'This will remove the item from the rewards catalog.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            confirmButtonText: 'Yes, delete'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/Admin/DeleteReward/' + id, function (res) {
                    if (res.success) {
                        Swal.fire('Deleted', res.msg, 'success').then(() => location.reload());
                    } else {
                        Swal.fire('Error', res.msg, 'error');
                    }
                });
            }
        });
    });
</script>
}

