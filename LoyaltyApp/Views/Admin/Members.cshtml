@model List<LoyaltyApp.DTOs.MemberDTO>
@{
    ViewData["Title"] = "Manage Members";
}

<div class="container-fluid py-4 px-4 bg-light min-vh-100">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a href="/Admin/Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">← Dashboard</a>
                <h1 class="h3 fw-bold text-dark mb-0">Member Directory 👥</h1>
            </div>
            <p class="text-muted small mt-1 mb-0">Manage customer accounts, membership tiers, and activation statuses.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <input type="text" id="memberSearch" class="form-control rounded-pill px-3" placeholder="Search by name, email, phone..." style="max-width: 280px;" />
            <button class="btn btn-primary shadow-sm rounded-pill px-4 fw-semibold" data-bs-toggle="modal" data-bs-target="#createMemberModal">
                + Enroll Member
            </button>
        </div>
    </div>

    <!-- Members Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="membersTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">#ID</th>
                        <th>Member Name</th>
                        <th>Phone / Email</th>
                        <th>Tier</th>
                        <th>Points</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 220px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var m in Model)
                        {
                            <tr class="member-row">
                                <td class="fw-semibold text-muted">#@m.MemberID</td>
                                <td>
                                    <div class="fw-bold text-dark">@m.Name</div>
                                    <span class="text-muted small">Ref: <code class="text-secondary">@(m.ReferralCode ?? "-")</code></span>
                                </td>
                                <td>
                                    <div>📱 @m.PhoneNumber</div>
                                    <div class="text-muted small">✉️ @m.Email</div>
                                </td>
                                <td>
                                    <span class="badge bg-warning-subtle text-dark rounded-pill px-3 py-1 fw-bold">
                                        @(m.Tier ?? "Gold")
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">⭐ @(m.Point ?? 0)</span>
                                </td>
                                <td>
                                    @if (m.AccountStatus == LoyaltyApp.DTOs.AccountStatus.Active)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">● Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1">○ Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 edit-member-btn me-1"
                                            data-id="@m.MemberID"
                                            data-guid="@m.MemberGUID"
                                            data-name="@m.Name"
                                            data-email="@m.Email"
                                            data-phone="@m.PhoneNumber"
                                            data-tier="@m.Tier">
                                        Edit
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 toggle-member-btn"
                                            data-id="@m.MemberID"
                                            data-name="@m.Name">
                                        Status
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <div class="fs-1 mb-2">👥</div>
                                <div>No members registered yet.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Enroll Member -->
<div class="modal fade" id="createMemberModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold">Enroll New Member</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="createMemberForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name</label>
                        <input type="text" name="Name" class="form-control rounded-pill px-3" placeholder="e.g. Rachel Lim" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone Number</label>
                        <input type="text" name="PhoneNumber" class="form-control rounded-pill px-3" placeholder="0123456789 (must start with 0)" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input type="email" name="Email" class="form-control rounded-pill px-3" placeholder="rachel@example.com" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Birthdate</label>
                            <input type="date" name="BirthDate" class="form-control rounded-pill px-3" value="2000-01-01" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Membership Tier</label>
                            <select name="Tier" class="form-select rounded-pill px-3">
                                <option value="Gold">Gold</option>
                                <option value="Platinum">Platinum</option>
                                <option value="Silver">Silver</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Initial Password</label>
                        <input type="password" name="password" class="form-control rounded-pill px-3" value="123456" required />
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="saveMemberBtn" class="btn btn-primary rounded-pill px-4 fw-semibold">Create Account</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Edit Member -->
<div class="modal fade" id="editMemberModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold">Edit Member Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editMemberForm">
                    <input type="hidden" id="editMemberId" name="MemberID" />
                    <input type="hidden" id="editMemberGuid" name="MemberGUID" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name</label>
                        <input type="text" id="editName" name="Name" class="form-control rounded-pill px-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input type="email" id="editEmail" name="Email" class="form-control rounded-pill px-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Membership Tier</label>
                        <select id="editTier" name="Tier" class="form-select rounded-pill px-3">
                            <option value="Gold">Gold</option>
                            <option value="Platinum">Platinum</option>
                            <option value="Silver">Silver</option>
                        </select>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="updateMemberBtn" class="btn btn-primary rounded-pill px-4 fw-semibold">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Live Search
    $('#memberSearch').on('input', function () {
        const query = $(this).val().toLowerCase().trim();
        $('.member-row').each(function () {
            const text = $(this).text().toLowerCase();
            $(this).toggle(!query || text.includes(query));
        });
    });

    // Create Member
    $('#createMemberForm').submit(function (e) {
        e.preventDefault();
        $('#saveMemberBtn').prop('disabled', true).text('Creating...');
        $.post('/Admin/CreateMember', $(this).serialize(), function (res) {
            $('#saveMemberBtn').prop('disabled', false).text('Create Account');
            if (res.success) {
                Swal.fire('Created', res.msg, 'success').then(() => location.reload());
            } else {
                Swal.fire('Error', res.msg, 'error');
            }
        });
    });

    // Edit Member Modal Open
    $('.edit-member-btn').click(function () {
        $('#editMemberId').val($(this).data('id'));
        $('#editMemberGuid').val($(this).data('guid'));
        $('#editName').val($(this).data('name'));
        $('#editEmail').val($(this).data('email'));
        $('#editTier').val($(this).data('tier'));

        new bootstrap.Modal(document.getElementById('editMemberModal')).show();
    });

    // Submit Edit
    $('#editMemberForm').submit(function (e) {
        e.preventDefault();
        $('#updateMemberBtn').prop('disabled', true).text('Updating...');
        $.post('/Admin/EditMember', $(this).serialize(), function (res) {
            $('#updateMemberBtn').prop('disabled', false).text('Save Changes');
            if (res.success) {
                Swal.fire('Updated', res.msg, 'success').then(() => location.reload());
            } else {
                Swal.fire('Error', res.msg, 'error');
            }
        });
    });

    // Toggle Status
    $('.toggle-member-btn').click(function () {
        const id = $(this).data('id');
        const name = $(this).data('name');

        Swal.fire({
            title: 'Toggle status for ' + name + '?',
            text: 'This will freeze or activate this member account.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#0d6efd',
            confirmButtonText: 'Yes, toggle'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/Admin/ToggleMemberStatus', { memberId: id }, function (res) {
                    if (res.success) {
                        Swal.fire('Updated', res.msg, 'success').then(() => location.reload());
                    } else {
                        Swal.fire('Error', res.msg, 'error');
                    }
                });
            }
        });
    });
</script>
}

