@model List<LoyaltyApp.DTOs.FeedbackDTO>
@{
    ViewData["Title"] = "Customer Feedback & Support";
}

<div class="container-fluid py-4 px-4 bg-light min-vh-100">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a href="/Admin/Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">← Dashboard</a>
                <h1 class="h3 fw-bold text-dark mb-0">Customer Feedback & Inquiries 💬</h1>
            </div>
            <p class="text-muted small mt-1 mb-0">Review service feedback, store ratings, and support inquiries submitted by customers.</p>
        </div>

        <input type="text" id="feedbackSearch" class="form-control rounded-pill px-3" placeholder="Filter by keyword or location..." style="max-width: 280px;" />
    </div>

    <!-- Feedback Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">#ID</th>
                        <th>Rating & Category</th>
                        <th>Title & Comments</th>
                        <th>Store Branch</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var f in Model)
                        {
                            <tr class="feedback-row">
                                <td class="fw-semibold text-muted">#@f.FeedbackID</td>
                                <td>
                                    <div class="fw-bold text-warning">
                                        @for (int i = 0; i < (int.TryParse(f.Rating, out int r) ? r : 5); i++)
                                        {
                                            <span>⭐</span>
                                        }
                                    </div>
                                    <span class="badge bg-light text-dark border small">@(f.Category ?? "Service")</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@f.Title</div>
                                    <p class="text-muted small mb-0">@f.Description</p>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">
                                        📍 @(f.Location ?? "General")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 view-feedback-btn"
                                            data-title="@f.Title"
                                            data-desc="@f.Description"
                                            data-rating="@f.Rating"
                                            data-loc="@f.Location">
                                        Details
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <div class="fs-1 mb-2">💬</div>
                                <div>No customer feedback tickets logged yet.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $('#feedbackSearch').on('input', function () {
        const query = $(this).val().toLowerCase().trim();
        $('.feedback-row').each(function () {
            const text = $(this).text().toLowerCase();
            $(this).toggle(!query || text.includes(query));
        });
    });

    $('.view-feedback-btn').click(function () {
        const title = $(this).data('title');
        const desc = $(this).data('desc');
        const rating = $(this).data('rating');
        const loc = $(this).data('loc');

        Swal.fire({
            title: title,
            html: `<div class="text-start">
                <p><strong>Rating:</strong> ${rating} / 5 Stars</p>
                <p><strong>Location:</strong> ${loc || 'General'}</p>
                <hr/>
                <p class="text-muted">${desc}</p>
            </div>`,
            confirmButtonText: 'Close',
            confirmButtonColor: '#0d6efd'
        });
    });
</script>
}

