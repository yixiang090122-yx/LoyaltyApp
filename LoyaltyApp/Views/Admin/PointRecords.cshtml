@model List<LoyaltyApp.DTOs.PointRecordDTO>
@{
    ViewData["Title"] = "Point Transactions Audit";
    var outlets = ViewBag.Outlets as List<LoyaltyApp.DTOs.OutletDTO> ?? new List<LoyaltyApp.DTOs.OutletDTO>();
    var selectedOutlet = ViewBag.SelectedOutlet as int?;
}

<div class="container-fluid py-4 px-4 bg-light min-vh-100">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a href="/Admin/Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">← Dashboard</a>
                <h1 class="h3 fw-bold text-dark mb-0">Points Ledger & Dispatch ⭐</h1>
            </div>
            <p class="text-muted small mt-1 mb-0">Audit in-store and system point allocations, filter by branch, or directly credit points to a customer.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- Filter by Outlet -->
            <select class="form-select rounded-pill px-3" onchange="location = this.value;" style="width: auto;">
                <option value="/Admin/PointRecords" selected="@(!selectedOutlet.HasValue)">All Outlets</option>
                @foreach (var o in outlets)
                {
                    <option value="/Admin/PointRecords?outletId=@o.OutletID" selected="@(selectedOutlet == o.OutletID)">
                        @o.OutletName
                    </option>
                }
            </select>

            <button class="btn btn-primary shadow-sm rounded-pill px-4 fw-semibold text-nowrap" data-bs-toggle="modal" data-bs-target="#directPointModal">
                + Direct Credit Points
            </button>
        </div>
    </div>

    <!-- Points Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">#ID</th>
                        <th>Member Details</th>
                        <th>Points Accrued</th>
                        <th>Outlet & Cashier</th>
                        <th>Date & Time</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var p in Model.OrderByDescending(x => x.DateAssign))
                        {
                            <tr>
                                <td class="fw-semibold text-muted">#@p.PointRecordID</td>
                                <td>
                                    <div class="fw-bold text-dark">@(p.Member?.Name ?? "Member")</div>
                                    <span class="text-muted small">📱 @(p.Member?.PhoneNumber ?? "-")</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-bold fs-6">
                                        +@(p.Point ?? 0) Pts
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@(p.OutletStaff?.Outlet?.OutletName ?? "System")</div>
                                    <span class="text-muted small">Cashier: @(p.OutletStaff?.OutletStaffName ?? "-")</span>
                                </td>
                                <td class="small text-muted">
                                    @p.DateAssign.ToString("yyyy-MM-dd HH:mm")
                                </td>
                                <td class="text-end">
                                    @if (p.PointRecordStatus == LoyaltyApp.DTOs.PointRecordStatus.Approve)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">● Approved</span>
                                    }
                                    else if (p.PointRecordStatus == LoyaltyApp.DTOs.PointRecordStatus.Rejected)
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1">✕ Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-dark rounded-pill px-3 py-1">◷ Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <div class="fs-1 mb-2">⭐</div>
                                <div>No point records found for this view.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Direct Point Dispatch -->
<div class="modal fade" id="directPointModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold">Direct Member Point Credit</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="directPointForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Customer Phone Number</label>
                        <input type="text" name="PhoneNumber" class="form-control rounded-pill px-3" placeholder="0123456789 (must start with 0)" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Points to Credit ⭐</label>
                        <input type="number" name="Point" class="form-control rounded-pill px-3" placeholder="e.g. 50" min="1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Branch Outlet</label>
                        <select name="OutletID" class="form-select rounded-pill px-3" required>
                            <option value="">-- Choose Branch --</option>
                            @foreach (var o in outlets)
                            {
                                <option value="@o.OutletID">@o.OutletName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Cashier Staff PIN 🔑</label>
                        <input type="password" name="Pin" class="form-control rounded-pill px-3 text-center fw-bold fs-5 tracking-wider" placeholder="123456" maxlength="6" required />
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="dispatchPointsBtn" class="btn btn-primary rounded-pill px-4 fw-semibold">Credit Points</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $('#directPointForm').submit(function (e) {
        e.preventDefault();
        $('#dispatchPointsBtn').prop('disabled', true).text('Crediting...');
        $.post('/Admin/OutletAssignPoint', $(this).serialize(), function (res) {
            $('#dispatchPointsBtn').prop('disabled', false).text('Credit Points');
            if (res.success) {
                Swal.fire('Points Credited!', res.msg, 'success').then(() => location.reload());
            } else {
                Swal.fire('Dispatch Failed', res.msg, 'error');
            }
        });
    });
</script>
}

