@{
    Layout = null;
}

@using LoyaltyApp.ViewModels.Account;
@using LoyaltyApp.ViewModels.Admin
@model AdminLoginVM

@{
    ViewData["Title"] = "Admin Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- jQuery CDN -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
</head>
<body class="bg-light">

    <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="card shadow-lg border-0 rounded-4 p-4 border-top border-dark border-4" style="width: 100%; max-width: 420px;">
            <div class="card-body">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-dark">Admin Portal</h2>
                    <p class="text-muted small">Restricted access. Authorized personnel only.</p>
                </div>

                <form id="submitForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" asp-for="Username"></label>
                        <input class="form-control form-control-lg" asp-for="Username" placeholder="Enter admin username" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold" asp-for="Password"></label>
                        <input class="form-control form-control-lg" asp-for="Password" type="password" placeholder="••••••••" />
                    </div>

                    <!-- Added id="loginBtn" to target the button -->
                    <button type="submit" id="loginBtn" class="btn btn-dark btn-lg w-100 shadow-sm mb-3">Admin Sign In</button>
                </form>

                <div class="text-center mt-3">
                    <span class="text-muted small">Looking for member portal?</span>
                    <a href="/Account/MemberLogin" class="text-decoration-none fw-semibold ms-1">Member Login</a>
                </div>
            </div>
        </div>
    </div>

    <script>
            $('#submitForm').on('submit', function(e) {
                e.preventDefault();

                var $btn = $('#loginBtn');

                // Reset state, disable button, show spinner
                $btn.prop('disabled', true)
                    .removeClass('btn-danger btn-success')
                    .addClass('btn-dark')
                    .html(`
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            Loading...
                        `);

                var formData = new FormData(this);

                $.ajax({
                    url: '/Account/AdminLogin',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        if (response.success) {
                            // Turn button green on success
                            $btn.removeClass('btn-dark btn-danger')
                                .addClass('btn-success')
                                .text('Access Granted!');

                            // Short delay so the user sees green success state before redirecting
                            setTimeout(function() {
                                window.location.href = response.redirectUrl;
                            }, 800);
                        } else {
                            // Turn button red on failure
                            $btn.removeClass('btn-dark btn-success')
                                .addClass('btn-danger')
                                .text('Invalid Credentials!');

                            // Re-enable button after 2 seconds and restore dark state
                            setTimeout(function() {
                                $btn.prop('disabled', false)
                                    .removeClass('btn-danger')
                                    .addClass('btn-dark')
                                    .text('Admin Sign In');
                            }, 2000);
                        }
                    },
                    error: function() {
                        // Turn button red on server error
                        $btn.removeClass('btn-dark btn-success')
                            .addClass('btn-danger')
                            .text('Error! Try Again');

                        setTimeout(function() {
                            $btn.prop('disabled', false)
                                .removeClass('btn-danger')
                                .addClass('btn-dark')
                                .text('Admin Sign In');
                        }, 2000);
                    }
                });
            });
    </script>
</body>
</html>