@{
    Layout = null;
    ViewData["Title"] = "Confirm New Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LoyaltyApp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-light">
    <div class="container d-flex justify-content-center align-items-center py-5" style="min-height: 100vh;">
        <div class="card shadow-lg border-0 rounded-4 p-4 bg-white" style="width: 100%; max-width: 440px;">
            <div class="card-body">
                <div class="text-center mb-4">
                    <span class="fs-1">🔒</span>
                    <h2 class="fw-bold text-primary mt-2">Enter OTP & Reset</h2>
                    <p class="text-muted small">Verify your 6-digit OTP code and choose a new password.</p>
                </div>

                <form id="resetForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone Number</label>
                        <input type="text" id="phone" name="PhoneNumber" value="@ViewBag.Phone" class="form-control rounded-pill px-3" placeholder="0123456789" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">6-Digit OTP Code</label>
                        <input type="text" id="otp" name="OTP" class="form-control rounded-pill px-3 text-center fw-bold fs-5 tracking-wider" placeholder="123456" maxlength="6" required />
                        <div class="form-text small text-muted">Check your email inbox or spam folder for the code.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">New Password</label>
                        <input type="password" id="newPass" name="NewPassword" class="form-control rounded-pill px-3" placeholder="Minimum 6 characters" minlength="6" required />
                    </div>

                    <button type="submit" id="resetBtn" class="btn btn-primary btn-lg rounded-pill w-100 shadow-sm mb-3 fw-semibold">
                        Confirm Reset Password
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a href="/Account/MemberLogin" class="text-decoration-none fw-semibold">← Return to Login</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        $('#resetForm').on('submit', function (e) {
            e.preventDefault();
            const $btn = $('#resetBtn');
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Updating...');

            $.ajax({
                url: '/Account/ResetPassword',
                type: 'POST',
                data: $(this).serialize(),
                success: function (res) {
                    $btn.prop('disabled', false).text('Confirm Reset Password');
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Password Updated!',
                            text: res.msg,
                            confirmButtonColor: '#0d6efd'
                        }).then(() => {
                            window.location.href = res.redirectUrl;
                        });
                    } else {
                        Swal.fire('Reset Failed', res.msg, 'error');
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).text('Confirm Reset Password');
                    Swal.fire('Error', 'Failed to communicate with the server.', 'error');
                }
            });
        });
    </script>
</body>
</html>

