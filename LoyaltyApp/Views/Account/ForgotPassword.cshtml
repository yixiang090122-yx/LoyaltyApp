@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LoyaltyApp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-light">
    <div class="container d-flex justify-content-center align-items-center py-5" style="min-height: 100vh;">
        <div class="card shadow-lg border-0 rounded-4 p-4 bg-white" style="width: 100%; max-width: 440px;">
            <div class="card-body">
                <div class="text-center mb-4">
                    <span class="fs-1">🔑</span>
                    <h2 class="fw-bold text-primary mt-2">Reset Password</h2>
                    <p class="text-muted small">Enter your phone number to receive a verification OTP code via email.</p>
                </div>

                <form id="forgotForm">
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Phone Number</label>
                        <input type="text" id="phone" name="PhoneNumber" class="form-control form-control-lg rounded-pill px-3" placeholder="e.g. 0123456789" required />
                        <div class="form-text small text-muted">A 6-digit OTP will be dispatched to your registered email address.</div>
                    </div>

                    <button type="submit" id="sendOtpBtn" class="btn btn-primary btn-lg rounded-pill w-100 shadow-sm mb-3 fw-semibold">
                        Request OTP Code
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a href="/Account/MemberLogin" class="text-decoration-none fw-semibold">← Back to Member Login</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        $('#forgotForm').on('submit', function (e) {
            e.preventDefault();
            const phone = $('#phone').val().trim();
            const $btn = $('#sendOtpBtn');

            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Sending OTP...');

            $.ajax({
                url: '/Account/ForgotPassword',
                type: 'POST',
                data: { PhoneNumber: phone },
                success: function (res) {
                    $btn.prop('disabled', false).text('Request OTP Code');
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'OTP Dispatched!',
                            text: res.msg,
                            confirmButtonColor: '#0d6efd'
                        }).then(() => {
                            window.location.href = res.redirectUrl;
                        });
                    } else {
                        Swal.fire('Error', res.msg, 'error');
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).text('Request OTP Code');
                    Swal.fire('Error', 'Unable to reach the server. Please try again.', 'error');
                }
            });
        });
    </script>
</body>
</html>

