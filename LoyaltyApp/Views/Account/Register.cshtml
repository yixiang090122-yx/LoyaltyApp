@model LoyaltyApp.DTOs.RegisterMemberVM
@{
    Layout = null;
    ViewData["Title"] = "Member Registration";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LoyaltyApp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-light">
    <div class="container d-flex justify-content-center align-items-center py-5" style="min-height: 100vh;">
        <div class="card shadow-lg border-0 rounded-4 p-4 bg-white" style="width: 100%; max-width: 480px;">
            <div class="card-body">
                <div class="text-center mb-4">
                    <span class="fs-1">🌟</span>
                    <h2 class="fw-bold text-primary mt-2">Create Account</h2>
                    <p class="text-muted small">Join our Loyalty Club to earn points and enjoy exclusive rewards!</p>
                </div>

                <form id="registerForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name</label>
                        <input class="form-control rounded-pill px-3" asp-for="Name" placeholder="e.g. Alex Tan" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone Number</label>
                        <input class="form-control rounded-pill px-3" asp-for="PhoneNumber" placeholder="e.g. 0123456789" required />
                        <div class="form-text small text-muted">Must start with 0 (e.g. 0123456789).</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input type="email" class="form-control rounded-pill px-3" asp-for="Email" placeholder="e.g. alex@example.com" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Date of Birth</label>
                        <input type="date" class="form-control rounded-pill px-3" asp-for="BirthDate" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Password</label>
                        <input type="password" class="form-control rounded-pill px-3" asp-for="Password" placeholder="Minimum 6 characters" minlength="6" required />
                    </div>

                    <button type="submit" id="regBtn" class="btn btn-primary btn-lg rounded-pill w-100 shadow-sm mb-3 fw-semibold">
                        Register Account
                    </button>
                </form>

                <div class="text-center mt-3">
                    <span class="text-muted small">Already a member?</span>
                    <a href="/Account/MemberLogin" class="text-decoration-none fw-semibold ms-1">Sign In Here</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        $('#registerForm').on('submit', function (e) {
            e.preventDefault();
            const phone = $('#PhoneNumber').val().trim();
            if (!phone.startsWith('0')) {
                Swal.fire('Validation Error', 'Phone number must start with 0 (e.g. 0123456789)', 'warning');
                return;
            }

            const $btn = $('#regBtn');
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Registering...');

            $.ajax({
                url: '/Account/Register',
                type: 'POST',
                data: $(this).serialize(),
                success: function (res) {
                    $btn.prop('disabled', false).text('Register Account');
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: res.msg,
                            confirmButtonColor: '#0d6efd'
                        }).then(() => {
                            window.location.href = res.redirectUrl;
                        });
                    } else {
                        Swal.fire('Registration Failed', res.msg, 'error');
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).text('Register Account');
                    Swal.fire('Server Error', 'Failed to communicate with authentication service.', 'error');
                }
            });
        });
    </script>
</body>
</html>

