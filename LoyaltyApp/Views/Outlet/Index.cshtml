@model List<LoyaltyApp.DTOs.OutletDTO>
@{
    ViewData["Title"] = "Manage Outlets";
}

<style>
    .hover-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

    .hover-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.08) !important;
    }
</style>

<div class="container-fluid py-4 px-4 bg-light min-vh-100">
    <!-- Top Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a href="/Admin/Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">← Dashboard</a>
                <h1 class="h3 fw-bold text-dark mb-0">Store Outlets & Staff 🏬</h1>
            </div>
            <p class="text-muted small mt-1 mb-0">Manage all store branches, locations, and staff verification PINs (used for in-store redemptions).</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary shadow-sm rounded-pill px-4 fw-semibold" data-bs-toggle="modal" data-bs-target="#createOutletModal">
                + Add New Outlet
            </button>
        </div>
    </div>

    <!-- Quick Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white hover-card border-start border-primary border-4">
                <span class="text-muted small fw-semibold text-uppercase">Total Outlets</span>
                <span class="fs-4 fw-bold text-dark mt-1">@(Model?.Count ?? 0)</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white hover-card border-start border-success border-4">
                <span class="text-muted small fw-semibold text-uppercase">Active Branches</span>
                <span class="fs-4 fw-bold text-success mt-1">@(Model?.Count(o => o.OutletStatus == LoyaltyApp.DTOs.OutletStatus.Active) ?? 0)</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white hover-card border-start border-secondary border-4">
                <span class="text-muted small fw-semibold text-uppercase">Deactivated Branches</span>
                <span class="fs-4 fw-bold text-secondary mt-1">@(Model?.Count(o => o.OutletStatus == LoyaltyApp.DTOs.OutletStatus.Deactive) ?? 0)</span>
            </div>
        </div>
    </div>

    <!-- Outlets Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">#ID</th>
                        <th>Outlet Name</th>
                        <th>Branch Identifier</th>
                        <th>Created Date</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 250px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-muted">#@item.OutletID</td>
                                <td class="fw-bold text-dark">
                                    <span class="me-1">📍</span> @item.OutletName
                                </td>
                                <td>
                                    <code class="small text-secondary">@(item.OutletGUID ?? "-")</code>
                                </td>
                                <td class="small text-muted">
                                    @(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                                </td>
                                <td>
                                    @if (item.OutletStatus == LoyaltyApp.DTOs.OutletStatus.Active)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2 fw-semibold">
                                            ● Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2 fw-semibold">
                                            ○ Deactive
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 manage-staff-btn me-1"
                                            data-id="@item.OutletID"
                                            data-name="@item.OutletName">
                                        Staff (PINs) 🔑
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 toggle-status-btn"
                                            data-id="@item.OutletID"
                                            data-name="@item.OutletName">
                                        Toggle Status
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <div class="fs-1 mb-2">🏬</div>
                                <div>No outlets registered yet. Click <strong>+ Add New Outlet</strong> above to create one.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Create Outlet -->
<div class="modal fade" id="createOutletModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold">Add Store Outlet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="createOutletForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Outlet Name</label>
                        <input type="text" id="outletName" class="form-control rounded-pill px-3 py-2" placeholder="e.g. Pavilion Bukit Jalil" required />
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="saveOutletBtn" class="btn btn-primary rounded-pill px-4 fw-semibold">Save Outlet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Manage Outlet Staff & PINs -->
<div class="modal fade" id="staffModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <div>
                    <h5 class="modal-title fw-bold mb-1">Outlet Staff & PINs 🔑</h5>
                    <p class="text-muted small mb-0">Branch: <span id="staffBranchName" class="fw-bold text-primary">-</span></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Add Staff Form -->
                <div class="p-3 bg-light rounded-4 mb-4 border">
                    <h6 class="fw-bold text-dark mb-3">+ Register Outlet Cashier</h6>
                    <form id="createStaffForm" class="row g-2 align-items-center">
                        <input type="hidden" id="staffOutletId" name="OutletID" />
                        <div class="col-md-4">
                            <input type="text" id="staffName" name="OutletStaffName" class="form-control rounded-pill px-3" placeholder="Staff Name (e.g. John)" required />
                        </div>
                        <div class="col-md-3">
                            <input type="text" id="staffRole" name="Role" class="form-control rounded-pill px-3" placeholder="Role (e.g. Cashier)" />
                        </div>
                        <div class="col-md-3">
                            <input type="password" id="staffPin" name="Pin" class="form-control rounded-pill px-3 text-center fw-bold" placeholder="6-Digit PIN" maxlength="6" required />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" id="addStaffBtn" class="btn btn-primary rounded-pill w-100 fw-semibold">Add</button>
                        </div>
                    </form>
                </div>

                <!-- Staff Table -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Staff Name</th>
                                <th>Role</th>
                                <th>Redemption PIN</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody id="staffTableBody">
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">Loading staff list...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $('#createOutletForm').submit(function (e) {
        e.preventDefault();
        const outletName = $('#outletName').val().trim();
        $('#saveOutletBtn').prop('disabled', true).text('Saving...');

        $.post('/Outlet/Create', { outletName: outletName }, function (res) {
            $('#saveOutletBtn').prop('disabled', false).text('Save Outlet');
            if (res.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Created!',
                    text: res.msg,
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => location.reload());
            } else {
                Swal.fire('Error', res.msg, 'error');
            }
        });
    });

    $(document).on('click', '.toggle-status-btn', function () {
        const id = $(this).data('id');
        const name = $(this).data('name');

        Swal.fire({
            title: 'Change status for ' + name + '?',
            text: 'This will toggle the outlet between Active and Deactive.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#0d6efd',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, update',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/Outlet/ToggleStatus/' + id, function (res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Updated!',
                            text: res.msg,
                            timer: 1200,
                            showConfirmButton: false
                        }).then(() => location.reload());
                    } else {
                        Swal.fire('Failed', res.msg, 'error');
                    }
                });
            }
        });
    });

    // Staff Management
    let currentOutletId = null;

    function loadStaff(outletId) {
        $('#staffTableBody').html('<tr><td colspan="4" class="text-center text-muted py-3"><span class="spinner-border spinner-border-sm me-2"></span>Loading...</td></tr>');
        $.get('/Outlet/GetStaffByOutlet?outletId=' + outletId, function (res) {
            if (res.success && res.data && res.data.length > 0) {
                let html = '';
                res.data.forEach(s => {
                    html += `<tr>
                        <td class="fw-bold">${s.outletStaffName || 'Staff'}</td>
                        <td><span class="badge bg-light text-dark border">${s.role || 'Cashier'}</span></td>
                        <td><code class="fw-bold text-primary fs-6">${s.pin || '••••••'}</code></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3 delete-staff-btn" data-id="${s.outletStaffID}">Delete</button>
                        </td>
                    </tr>`;
                });
                $('#staffTableBody').html(html);
            } else {
                $('#staffTableBody').html('<tr><td colspan="4" class="text-center text-muted py-3">No staff members enrolled for this branch yet.</td></tr>');
            }
        });
    }

    $(document).on('click', '.manage-staff-btn', function () {
        currentOutletId = $(this).data('id');
        const name = $(this).data('name');

        $('#staffOutletId').val(currentOutletId);
        $('#staffBranchName').text(name);
        $('#createStaffForm')[0].reset();
        $('#staffOutletId').val(currentOutletId);

        loadStaff(currentOutletId);
        new bootstrap.Modal(document.getElementById('staffModal')).show();
    });

    $('#createStaffForm').submit(function (e) {
        e.preventDefault();
        const pin = $('#staffPin').val().trim();
        if (pin.length !== 6) {
            Swal.fire('Error', 'PIN must be exactly 6 digits.', 'error');
            return;
        }

        $('#addStaffBtn').prop('disabled', true).text('Adding...');
        $.post('/Outlet/CreateStaff', $(this).serialize(), function (res) {
            $('#addStaffBtn').prop('disabled', false).text('Add');
            if (res.success) {
                $('#createStaffForm')[0].reset();
                $('#staffOutletId').val(currentOutletId);
                loadStaff(currentOutletId);
            } else {
                Swal.fire('Error', res.msg, 'error');
            }
        });
    });

    $(document).on('click', '.delete-staff-btn', function () {
        const id = $(this).data('id');
        Swal.fire({
            title: 'Remove staff member?',
            text: 'This staff PIN will no longer be able to approve redemptions.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            confirmButtonText: 'Yes, delete'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/Outlet/DeleteStaff/' + id, function (res) {
                    if (res.success) {
                        loadStaff(currentOutletId);
                    } else {
                        Swal.fire('Error', res.msg, 'error');
                    }
                });
            }
        });
    });
</script>
}
