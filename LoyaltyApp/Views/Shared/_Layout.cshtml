@{
    // Check if the current controller is Admin or if an Admin session exists
    var isAdminPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ||
                      !string.IsNullOrEmpty(Context.Session.GetString("AdminUser"));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LoyaltyApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
            .nav-link-custom {
                font-weight: 500;
                transition: all 0.2s ease;
            }

                .nav-link-custom:hover {
                    color: #0d6efd !important;
                    background-color: #f8f9fa;
                }

            .points-badge {
                background: linear-gradient(135deg, #0d6efd, #0dcaf0);
                color: white;
                font-weight: 600;
                padding: 0.35rem 0.85rem;
                border-radius: 50rem;
                font-size: 0.85rem;
            }
    </style>
</head>
<body class="bg-light">

    @if (isAdminPage)
    {
        <!-- ADMIN NAVBAR / TOP BAR -->
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3 shadow-sm py-2">
                <div class="container-fluid">
                    <a class="navbar-brand fw-bold" href="/Admin/Index">⚡ Admin Portal</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavCollapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="adminNavCollapse">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                            <li class="nav-item">
                                <a class="nav-link text-light px-3 rounded-pill" asp-controller="Admin" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light px-3 rounded-pill" asp-controller="Admin" asp-action="Members">Members</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light px-3 rounded-pill" href="#" role="button" data-bs-toggle="dropdown">
                                    Catalog
                                </a>
                                <ul class="dropdown-menu shadow border-0 rounded-3">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Rewards">🎁 Rewards</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Vouchers">🎟️ Vouchers</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Highlights">🔥 Promotional Banners</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light px-3 rounded-pill" href="#" role="button" data-bs-toggle="dropdown">
                                    Operations
                                </a>
                                <ul class="dropdown-menu shadow border-0 rounded-3">
                                    <li><a class="dropdown-item" asp-controller="Outlet" asp-action="Index">🏬 Outlets & Staff PINs</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="PointRecords">⭐ Points Ledger</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="RedemptionRecords">📜 Redemptions Audit</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light px-3 rounded-pill" asp-controller="Admin" asp-action="Feedback">Feedback</a>
                            </li>
                        </ul>
                        <div class="d-flex align-items-center">
                            <form id="adminLogoutForm" asp-controller="Account" asp-action="AdminLogout" method="post" class="mb-0">
                                <button type="button" id="confirmAdminLogoutBtn" class="btn btn-outline-danger btn-sm rounded-pill px-3">Admin Logout</button>
                            </form>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }
    else
    {
        <!-- ADVANCED MEMBER NAVBAR -->
        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm py-3 mb-4">
                <div class="container-fluid">
                    <!-- Brand / Logo -->
                    <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2 ms-2" asp-controller="Home" asp-action="Index">
                        <span>🌟</span> LoyaltyApp
                    </a>

                    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <!-- Navigation Links -->
                        <ul class="navbar-nav flex-grow-1 ms-3 gap-1">
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-dark px-3 rounded-pill" asp-controller="Member" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-dark px-3 rounded-pill" asp-controller="Member" asp-action="Rewards">Rewards</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-dark px-3 rounded-pill" asp-controller="Member" asp-action="Vouchers">Vouchers</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-dark px-3 rounded-pill" asp-controller="Member" asp-action="CollectPoints">Collect Points</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-dark px-3 rounded-pill" asp-controller="Member" asp-action="History">History</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-dark px-3 rounded-pill" asp-controller="Outlet" asp-action="Locations">Outlets</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom text-dark px-3 rounded-pill" asp-controller="Member" asp-action="Feedback">Feedback</a>
                            </li>
                        </ul>

                        <!-- Right Side: Profile & Logout -->
                        <ul class="navbar-nav align-items-center gap-2 me-2">
                            <li class="nav-item">
                                <a href="/Member/Details" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                    👤 My Profile
                                </a>
                            </li>
                            <li class="nav-item">
                                <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                                    <button type="button" id="confirmLogoutBtn" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold">
                                        🚪 Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Handles both Admin & Member Logout Confirmation -->
    <script>
            // Admin Logout
            $(document).on('click', '#confirmAdminLogoutBtn', function (e) {
                e.preventDefault();
                Swal.fire({
                    title: 'Exit Admin Panel?',
                    text: "You will be logged out of the admin session.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Log out',
                    cancelButtonText: 'Cancel',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.getElementById('adminLogoutForm').submit();
                    }
                });
            });

            // Member Logout
            $(document).on('click', '#confirmLogoutBtn', function (e) {
                e.preventDefault();
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You will be logged out of your session.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Log out',
                    cancelButtonText: 'Cancel',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.getElementById('logoutForm').submit();
                    }
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>